USE_MOCKS=true                # set false when connecting real APIs
DATABASE_URL=                 # Neon/Supabase pooled connection string
DIRECT_URL=                   # direct (non-pooled) connection string
REDIS_URL=                    # Upstash Redis TLS URL: rediss://default:<password>@<host>:6379
ANTHROPIC_API_KEY=            # optional if USE_MOCKS=true
CRON_SECRET=                  # shared secret for /api/cron/audits
ADMIN_USER=admin
ADMIN_PASSWORD=               # simple admin login for the live demo
REPORTS_DIR=/tmp/reports
NEXT_PUBLIC_APP_URL=
FALLBACK_PROCESS=false        # true only when the standalone worker is not running
