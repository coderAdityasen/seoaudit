// use prisma-8

enum AuditStatus {
  QUEUED = "QUEUED"
  RUNNING = "RUNNING"
  COMPLETED = "COMPLETED"
  FAILED = "FAILED"
}

model Client {
  id           String  @id @onCreate(cuid(2))
  name         String
  websiteUrl   String  @unique
  businessType String
  city         String
  state        String
  whatsapp     String?
  email        String?
  createdAt    DateTime @default(now())
  audits       Audit[]
}

model Audit {
  id             String      @id @onCreate(cuid(2))
  clientId       String
  client         Client      @relation(fields: [clientId], references: [id])
  status         AuditStatus @default(QUEUED)
  progress       Int         @default(0)
  currentStep    String?
  triggeredBy    String      @default("manual")
  overallScore   Int?
  scoreBreakdown Json?
  signals        Json?
  result         Json?
  pdfPath        String?
  errorMessage   String?
  createdAt      DateTime    @default(now())
  completedAt    DateTime?
  notifications  Notification[]

  @@index([clientId, createdAt])
}

model Notification {
  id         String   @id @onCreate(cuid(2))
  auditId    String
  audit      Audit    @relation(fields: [auditId], references: [id])
  channel    String
  status     String
  providerId String?
  createdAt  DateTime @default(now())
}